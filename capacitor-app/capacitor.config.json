{
  "appId": "com.kotiliy.yorunge",
  "appName": "Yörünge",
  "webDir": "www",
  "backgroundColor": "#0a0526ff",
  "android": {
    "backgroundColor": "#0a0526ff",
    "allowMixedContent": false
  },
  "ios": {
    "backgroundColor": "#0a0526ff",
    "contentInset": "never"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 400,
      "launchAutoHide": true,
      "backgroundColor": "#0a0526",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP",
      "splashFullScreen": true,
      "splashImmersive": true
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0a0526",
      "overlaysWebView": false
    }
  }
}
